# база данных для разработки — SQLite, для продакшена — PostgreSQL
# пример SQLite:
DATABASE_URL=sqlite:///./exam.db
# пример PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://exam:secret@localhost:5432/exam

# сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
APP_ENV=development
DEBUG=false

# безопасность
SECRET_KEY=change-me-to-random-64-chars-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# администратор по умолчанию (создаётся при первом запуске)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin12345

STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

DEFAULT_EXAM_DURATION_MINUTES=235